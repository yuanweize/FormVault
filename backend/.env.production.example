# Production Environment Configuration Template
# COPY THIS FILE TO .env.production AND CONFIGURE SECURE PRODUCTION CREDENTIALS
# DO NOT COMMIT THE ACTUAL .env.production FILE TO VERSION CONTROL

# Database Configuration (MySQL 8.0+)
DATABASE_URL=mysql+pymysql://formvault_user:CHANGE_ME_STRONG_DB_PASSWORD@localhost:3306/formvault_prod
DB_HOST=localhost
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Security Configuration
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ADMIN_SECRET_KEY=CHANGE_ME_ADMIN_BOOTSTRAP_SECRET_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ENV_ADMIN_ENABLED=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Regulatory & Scope Gate
BUSINESS_SCOPE_MODE=LEAD_ONLY
NON_LEAD_MODES_ENABLED=false
DEMO_DATA=false

# CORS Configuration
CORS_ORIGINS=https://insure.hktse.eu.org,https://pojisteni.hktse.eu.org

# File Upload & Encrypted Storage
UPLOAD_DIR=/opt/formvault/uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_TLS=true
FROM_EMAIL=insurance@hktse.eu.org

# SSL / Ingress
FORCE_HTTPS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=/opt/formvault/logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Security Headers & Rate Limiting
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' https://client.crisp.chat; style-src 'self' 'unsafe-inline' https://client.crisp.chat; font-src 'self' https://client.crisp.chat; img-src 'self' data: https:; connect-src 'self' https: wss://client.crisp.chat;"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
ENABLE_METRICS=false
METRICS_PORT=9090
