# ==============================================================================
# FormVault Environment Configuration
# ==============================================================================

# Port Mappings (Non-conflicting dedicated ports)
FRONTEND_PORT=9080
BACKEND_PORT=9081
DB_PORT=13306

# Database Configuration
DB_NAME=formvault
DB_USER=formvault
DB_PASSWORD=formvault_pass_2026
DB_ROOT_PASSWORD=formvault_root_2026

# Admin Credentials (Used for fallback login & initial admin dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=FormVault@Admin2026!
ADMIN_SECRET_KEY=formvault-admin-session-secret-key-2026

# Security & Encryption
SECRET_KEY=formvault-sec-jwt-token-key-change-in-prod

# Storage Configuration (local or s3)
STORAGE_TYPE=local

# Optional S3 Settings (if STORAGE_TYPE=s3)
# S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# S3_BUCKET=formvault-bucket
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_REGION=us-east-1

# Optional Email / SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_username
# SMTP_PASSWORD=your_password
# FROM_EMAIL=noreply@formvault.com
